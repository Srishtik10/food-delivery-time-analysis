      <column caption='On time ' datatype='integer' name='[Calculation_1539105175098925056]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Delivery_Time_min] &lt;= 45 THEN 1 ELSE 0 END' />
      </column>
      <column caption='On time Delivery Rate' datatype='real' name='[Calculation_1539105175099432961]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [Delivery_Time_min] &lt;= 45 THEN 1 ELSE 0 END)' />
      </column>
      <column caption='bins' datatype='string' name='[Calculation_1764848107792736256]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Preparation_Time_min] = 0 THEN &quot;0 min&quot;&#13;&#10;ELSEIF [Preparation_Time_min] &lt;= 5 THEN &quot;0-5 min&quot;&#13;&#10;ELSEIF [Preparation_Time_min] &lt;= 10 THEN &quot;5-10 min&quot;&#13;&#10;ELSEIF [Preparation_Time_min] &lt;= 15 THEN &quot;10-15 min&quot;&#13;&#10;ELSEIF [Preparation_Time_min] &lt;= 20 THEN &quot;15-20 min&quot;&#13;&#10;ELSE &quot;20+ min&quot;&#13;&#10;END' />
      </column>
