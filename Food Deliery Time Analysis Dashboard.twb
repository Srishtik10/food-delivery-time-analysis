        <calculation class='tableau' formula='&quot;&quot;' />
      </column>
      <column caption='Experience Group' datatype='string' name='[Calculation_1764848108174360580]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Courier_Experience_yrs] &lt;= 1 THEN &quot;0-1 yrs&quot;&#13;&#10;ELSEIF [Courier_Experience_yrs] &lt;= 3 THEN &quot;1-3 yrs&quot;&#13;&#10;ELSE &quot;3+ yrs&quot;&#13;&#10;END' />
      </column>
      <column caption='Delivery Rate Status.' datatype='string' name='[Calculation_1764848108179030021]' role='measure' type='nominal'>
